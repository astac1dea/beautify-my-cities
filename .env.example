# Copy to .env and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# Both of these are client-side values: Vite inlines anything prefixed VITE_
# into the browser bundle, so the anon key is already public on the deployed
# site. It is safe here. The service_role key is NOT - it bypasses row-level
# security entirely and must never appear in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
